# DeepResearch AI - Environment Configuration

# Application Setup
APP_ENV=development
DEBUG=True
SECRET_KEY=super_secret_jwt_key_change_in_production_min_32_chars
ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_MINUTES=1440

# Database (SQLite for dev, PostgreSQL ready for prod)
# SQLite default: sqlite:///./deepresearch.db
# PostgreSQL example: postgresql://user:password@localhost:5432/deepresearch
DATABASE_URL=sqlite:///./deepresearch.db

# AI API Providers (Configurable)
# Supported providers: openai, gemini, anthropic, fallback
DEFAULT_AI_PROVIDER=fallback
OPENAI_API_KEY=
GEMINI_API_KEY=
ANTHROPIC_API_KEY=

# Search Providers (Configurable)
# Supported: duckduckgo, tavily, serper
DEFAULT_SEARCH_PROVIDER=duckduckgo
TAVILY_API_KEY=
SERPER_API_KEY=

# CORS Settings
CORS_ORIGINS=["http://localhost:5173", "http://localhost:3000", "http://127.0.0.1:5173"]
